#!/bin/bash

# hyprwhspr launcher
export PYTHONDONTWRITEBYTECODE=1

# Legacy checkouts may still depend on packages installed by old bootstrap
# versions into the user site. The managed launcher isolates its own environments.
unset PYTHONHOME

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname $(readlink -f "$0"))" && pwd)"
PACKAGE_ROOT="$(dirname "$SCRIPT_DIR")"
if [[ -f "$PACKAGE_ROOT/release.json" && -x "${XDG_DATA_HOME:-$HOME/.local/share}/hyprwhspr/launcher" ]]; then
    exec "${XDG_DATA_HOME:-$HOME/.local/share}/hyprwhspr/launcher" "$@"
fi

# Determine the library directory
# Development: lib/cli.py exists directly under PACKAGE_ROOT
# Installed: lib/hyprwhspr/cli.py under PACKAGE_ROOT (e.g., ~/.local/lib/hyprwhspr/)
if [ -f "$PACKAGE_ROOT/lib/cli.py" ]; then
    LIB_DIR="$PACKAGE_ROOT/lib"
elif [ -f "$PACKAGE_ROOT/lib/hyprwhspr/cli.py" ]; then
    LIB_DIR="$PACKAGE_ROOT/lib/hyprwhspr"
else
    echo "Error: Cannot find hyprwhspr library files." >&2
    echo "Searched in:" >&2
    echo "  $PACKAGE_ROOT/lib/cli.py" >&2
    echo "  $PACKAGE_ROOT/lib/hyprwhspr/cli.py" >&2
    exit 1
fi

# Set environment variables
export HYPRWHSPR_ROOT="$PACKAGE_ROOT"
export PYTHONPATH="$LIB_DIR${PYTHONPATH:+:$PYTHONPATH}"

# Find system Python, avoiding mise/pyenv/asdf/homebrew managed versions
# CLI commands use system Python since deps are installed via package manager
SYSTEM_PYTHON_CANDIDATES=(
    /usr/bin/python3
    /usr/bin/python
    /bin/python3
    /bin/python
    /usr/local/bin/python3
    /usr/local/bin/python
)

# hyprwhspr requires 3.11-3.14, matching managed_install.interpreter(),
# scripts/install.sh and scripts/managed-launcher.sh. Reject older interpreters
# here so the user gets this message instead of an AttributeError from
# hashlib.file_digest deeper in the CLI.
supported_python() {
    "$1" -c 'import sys; raise SystemExit(0 if (3, 11) <= sys.version_info[:2] <= (3, 14) else 1)' 2>/dev/null
}

get_system_python() {
    local py
    for py in "${SYSTEM_PYTHON_CANDIDATES[@]}"; do
        [ -x "$py" ] && supported_python "$py" && { echo "$py"; return 0; }
    done
    py="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
    if [ -n "$py" ] \
        && [ -z "${VIRTUAL_ENV:-}" ] \
        && [ -z "${MISE_SHELL:-}" ] \
        && [ -z "${__MISE_ACTIVATE:-}" ] \
        && { [ -z "${HOME:-}" ] || [[ "$py" != "$HOME/"* ]]; } \
        && [[ "$py" != *"/.local/share/mise/"* ]] \
        && [[ "$py" != *"/.pyenv/"* ]] \
        && [[ "$py" != *"/.asdf/"* ]] \
        && "$py" -c 'import sys; raise SystemExit(0 if sys.prefix == sys.base_prefix else 1)' \
        && supported_python "$py"; then
        echo "$py"
        return 0
    fi
    return 1
}

# Always use system Python for CLI commands
# Dependencies (python-rich, etc.) are installed via package manager to system site-packages
# This avoids issues with mise/pyenv/asdf hijacking python3 to a version without those deps
CLI_PYTHON="$(get_system_python)"
if [[ -z "$CLI_PYTHON" ]]; then
    echo "Error: No supported system Python found (need 3.11-3.14)." >&2
    echo "hyprwhspr requires system Python with distro packages (python-rich, etc.)." >&2
    echo "Install a supported Python via your package manager, for example:" >&2
    echo "  pacman -S python     apt install python3.12     dnf install python3.12" >&2
    exit 1
fi

# Find venv Python (for main app execution)
VENV_PYTHON="${XDG_DATA_HOME:-$HOME/.local/share}/hyprwhspr/venv/bin/python"
PYTHON_CMD="$VENV_PYTHON"

require_app_venv() {
    if [ ! -x "$VENV_PYTHON" ]; then
        echo "Error: hyprwhspr setup is incomplete." >&2
        echo "Python environment not found at: $VENV_PYTHON" >&2
        echo "Run setup to install the required Python dependencies:" >&2
        echo "  $0 setup" >&2
        exit 1
    fi
}

# Help/version handling: route -h/--help/--version to CLI
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    exec "$CLI_PYTHON" -B "$LIB_DIR/cli.py" --help
  fi
  if [[ "$arg" == "--version" && "$1" != "update" ]]; then
    exec "$CLI_PYTHON" -B "$LIB_DIR/cli.py" --version
  fi
done

if [[ "$1" == "help" ]]; then
  exec "$CLI_PYTHON" -B "$LIB_DIR/cli.py" --help
fi

# Subcommands: route to CLI if recognized
# Keep in sync with CLI_SUBCOMMANDS in lib/main.py
# 'test' and 'transcribe' need venv Python since they load transcription dependencies
if [[ "$1" == "test" || "$1" == "transcribe" ]]; then
  require_app_venv
  exec "$PYTHON_CMD" -B "$LIB_DIR/cli.py" "$@"
fi
if [[ "$1" =~ ^(update|setup|install|config|waybar|noctalia|systemd|status|model|validate|uninstall|backend|state|mic-osd|keyboard|record|test|transcribe)$ ]]; then
  exec "$CLI_PYTHON" -B "$LIB_DIR/cli.py" "$@"
fi

# The service always runs in the environment created by setup. Falling back to
# system Python turns an incomplete installation into misleading import errors.
require_app_venv

# Set up CUDA library path if CUDA is installed
if [ -d "/opt/cuda" ]; then
  CUDA_LIB_DIRS=""
  [ -d "/opt/cuda/lib" ] && CUDA_LIB_DIRS="/opt/cuda/lib"
  [ -d "/opt/cuda/lib64" ] && CUDA_LIB_DIRS="${CUDA_LIB_DIRS:+$CUDA_LIB_DIRS:}/opt/cuda/lib64"
  
  if [ -n "$CUDA_LIB_DIRS" ]; then
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}${CUDA_LIB_DIRS}"
  fi
fi

# Set up ROCm library path if ROCm is installed
if [ -d "/opt/rocm" ]; then
  ROCM_LIB_DIRS=""
  [ -d "/opt/rocm/lib" ] && ROCM_LIB_DIRS="/opt/rocm/lib"
  [ -d "/opt/rocm/lib64" ] && ROCM_LIB_DIRS="${ROCM_LIB_DIRS:+$ROCM_LIB_DIRS:}/opt/rocm/lib64"
  
  if [ -n "$ROCM_LIB_DIRS" ]; then
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}${ROCM_LIB_DIRS}"
  fi
fi

# Default: run main application with venv Python
exec "$PYTHON_CMD" -B "$LIB_DIR/main.py" "$@"
